{"version": 2, "width": 116, "height": 28, "timestamp": 1784941409, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.020212, "o", "Pi workflow: model routing and context resources\r\n"]
[0.173804, "o", "Type workflow commands; use exit to close.\r\n"]
[0.326781, "o", "\r\n"]
[0.480533, "o", "pi> "]
[0.538804, "i", "choose model\r"]
[0.538874, "o", "choose model\r\n"]
[0.539458, "o", "user> choose model\r\nassistant> pi --provider openai --model gpt-4o-mini\r\n"]
[0.893954, "o", "assistant> pi --model sonnet:high --thinking high\r\n"]
[1.247969, "o", "assistant> pi --models claude-sonnet,claude-haiku,gpt-4o\r\n"]
[1.602861, "o", "assistant> MODEL ROUTING READY\r\n"]
[1.662281, "i", "load context\r"]
[1.662426, "o", "load context\r\n"]
[1.954203, "o", "\r\npi> "]
[1.954302, "o", "user> load context\r\n"]
[1.95433, "o", "assistant> pi --append-system-prompt project-rules.md\r\n"]
[2.309103, "o", "assistant> pi --skill ./skills/reviewer\r\n"]
[2.660857, "o", "assistant> pi --prompt-template ./prompts/fix-bug.md\r\n"]
[3.015526, "o", "assistant> CONTEXT RESOURCES LOADED\r\n"]
[3.072638, "i", "configure startup\r"]
[3.072875, "o", "configure startup\r\n"]
[3.370346, "o", "\r\npi> "]
[3.370421, "o", "user> configure startup\r\nassistant> pi --offline --no-context-files --no-extensions --no-skills\r\n"]
[3.724834, "o", "assistant> pi --theme ./themes/quiet.json --no-themes\r\n"]
[4.079356, "o", "assistant> startup behavior is explicit and reviewable.\r\n"]
[4.434013, "o", "assistant> MODEL CONTEXT WORKFLOW COMPLETE\r\n"]
[4.497737, "i", "exit\r"]
[4.497872, "o", "exit\r\n"]
[4.785728, "o", "\r\npi> "]
[4.785812, "o", "assistant> Closing Pi workflow demonstration.\r\n"]
[4.990954, "o", "WORKFLOW SESSION COMPLETE\r\n"]
