{
  "name": "pi-version",
  "description": "Capture Pi version output and verify the launcher banner.",
  "priority": "P0",
  "execution": "scripted",
  "determinism": "deterministic",
  "checks": [
    "Pi version renders",
    "terminal evidence is recorded"
  ],
  "renderers": {
    "default": []
  },
  "command": {
    "argv": ["examples/bin/pi-clean", "--version"],
    "pty": false
  },
  "timeout_seconds": 10,
  "cols": 100,
  "rows": 12,
  "steps": [
    {
      "action": "wait_for_text",
      "text": ".",
      "timeout_seconds": 5
    }
  ],
  "assertions": [
    {
      "name": "sandbox failure is absent",
      "type": "output_not_contains",
      "value": "sandbox_apply",
      "detail": "sandbox failure is absent"
    },
    {
      "name": "sandbox launcher error is absent",
      "type": "output_not_contains",
      "value": "sandbox-exec",
      "detail": "sandbox launcher error is absent"
    }
  ],
  "expect_exit_code": 0
}
