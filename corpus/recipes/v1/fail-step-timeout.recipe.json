{
  "recipe_version": 1,
  "name": "fail-step-timeout",
  "description": "Failed step timeout: wait_for_text never matches.",
  "priority": "P2",
  "execution": "scripted",
  "determinism": "deterministic",
  "command": {
    "argv": [
      "python3",
      "banner.py"
    ],
    "cwd": "corpus/apps",
    "pty": false
  },
  "expect_exit_code": 0,
  "timeout_seconds": 10,
  "cols": 80,
  "rows": 24,
  "steps": [
    {
      "name": "wait never",
      "action": "wait_for_text",
      "text": "NEVER-PRESENT-12345",
      "timeout_seconds": 1
    }
  ],
  "assertions": [
    {
      "name": "banner",
      "type": "output_contains",
      "value": "TermProof"
    }
  ]
}
