{
  "name": "pi-help",
  "description": "Capture and verify Pi's terminal help surface.",
  "priority": "P0",
  "execution": "scripted",
  "determinism": "deterministic",
  "checks": [
    "Pi help renders",
    "terminal evidence is recorded"
  ],
  "renderers": {
    "default": []
  },
  "command": {
    "argv": ["examples/bin/pi-clean", "--help"],
    "pty": false
  },
  "timeout_seconds": 20,
  "cols": 110,
  "rows": 42,
  "steps": [
    {
      "action": "wait_for_text",
      "text": "Usage:",
      "timeout_seconds": 10
    }
  ],
  "assertions": [
    {
      "type": "output_contains",
      "value": "Usage:"
    },
    {
      "type": "output_contains",
      "value": "Built-in Tool Names"
    },
    {
      "name": "sandbox failure is absent",
      "type": "output_not_contains",
      "value": "sandbox_apply",
      "detail": "sandbox failure is absent"
    },
    {
      "name": "sandbox launcher error is absent",
      "type": "output_not_contains",
      "value": "sandbox-exec",
      "detail": "sandbox launcher error is absent"
    }
  ],
  "expect_exit_code": 0
}
