[0.016929, "o", "Pi workflow: session resume, fork, and export\r\n"]
[0.171895, "o", "Type workflow commands; use exit to close.\r\n"]
[0.327119, "o", "\r\n"]
[0.480967, "o", "pi> "]
[0.538952, "i", "start session\r"]
[0.539104, "o", "start session\r\n"]
[0.539474, "o", "user> start session\r\nassistant> pi --name \"Verifier workflow audit\" --session-dir .pi-sessions\r\n"]
[0.890224, "o", "assistant> session id: workflow-001.\r\n"]
[1.24154, "o", "assistant> SESSION STARTED\r\n"]
[1.298151, "i", "continue session\r"]
[1.298466, "o", "continue session\r\n"]
[1.596022, "o", "\r\npi> "]
[1.596143, "o", "user> continue session\r\nassistant> pi --continue \"What did we verify?\"\r\n"]
[1.948509, "o", "assistant> pi --session workflow-001\r\n"]
[2.299578, "o", "assistant> previous context restored.\r\n"]
[2.654649, "o", "assistant> SESSION RESUMED\r\n"]
[2.715382, "i", "fork export\r"]
[2.715666, "o", "fork export\r\n"]
[3.009361, "o", "\r\npi> "]
[3.009641, "o", "user> fork export\r\nassistant> pi --fork workflow-001 --name \"Workflow audit branch\"\r\n"]
[3.364093, "o", "assistant> pi --export session.jsonl output.html\r\n"]
[3.717195, "o", "assistant> exported review artifact for handoff.\r\n"]
[4.071773, "o", "assistant> SESSION RESUME EXPORT COMPLETE\r\n"]
[4.133451, "i", "exit\r"]
[4.133711, "o", "exit\r\n"]
[4.425213, "o", "\r\npi> "]
[4.425497, "o", "assistant> Closing Pi workflow demonstration.\r\n"]
[4.62679, "o", "WORKFLOW SESSION COMPLETE\r\n"]
