{
  "name": "pi-codex-operator",
  "description": "Use Codex as the verification operator for Pi's terminal help workflow.",
  "intent": "Show that an agent can exercise a terminal workflow, judge the checks, and let the harness publish cast, screenshots, video, and reports.",
  "priority": "P1",
  "execution": "agent-driven",
  "determinism": "agentic",
  "checks": [
    "Pi help renders",
    "sandbox failure is absent",
    "terminal evidence is recorded"
  ],
  "operator": {
    "type": "codex",
    "command": ["examples/bin/codex-clean", "exec", "--skip-git-repo-check"],
    "timeout_seconds": 180,
    "prompt_mode": "stdin",
    "record_terminal": true
  },
  "renderers": {
    "default": []
  },
  "command": {
    "argv": ["examples/bin/pi-clean", "--help"],
    "pty": false
  },
  "timeout_seconds": 20,
  "cols": 110,
  "rows": 42,
  "steps": [
    {
      "action": "wait_for_text",
      "text": "Usage:",
      "timeout_seconds": 10
    }
  ],
  "expect_exit_code": null
}
